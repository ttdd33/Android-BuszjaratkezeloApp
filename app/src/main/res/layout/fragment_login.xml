<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/login_background"
    tools:context=".ui.loginFragment" >

    <androidx.constraintlayout.utils.widget.ImageFilterView
        android:id="@+id/busLogoImageFilterView"
        android:layout_width="120dp"
        android:layout_height="120dp"
        android:layout_marginTop="80dp"
        android:background="#3F51B5"
        android:src="@drawable/bus_logo"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:roundPercent="1" />

    <TextView
        android:id="@+id/vallalatiTextView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="Vállalati"
        android:textColor="#3F51B5"
        android:textSize="34sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/busLogoImageFilterView" />

    <TextView
        android:id="@+id/buszjaratokTextView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Buszjáratok"
        android:textColor="#3F51B5"
        android:textSize="34sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/vallalatiTextView" />

    <EditText
        android:id="@+id/userPlainText"
        android:layout_width="278dp"
        android:layout_height="41dp"
        android:layout_marginTop="210dp"
        android:background="#FFFFFF"
        android:elevation="5dp"
        android:ems="10"
        android:gravity="center_horizontal|center_vertical"
        android:hint="Felhasználónév"
        android:inputType="text"
        android:minHeight="40dp"
        android:singleLine="true"
        android:textColor="#000000"
        android:textColorHint="#3F51B5"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/buszjaratokTextView" />

    <EditText
        android:id="@+id/editTextTextPassword"
        android:layout_width="275dp"
        android:layout_height="38dp"
        android:layout_marginTop="8dp"
        android:background="#FFFFFF"
        android:elevation="5dp"
        android:ems="10"
        android:gravity="center_horizontal|center_vertical"
        android:hint="Jelszó"
        android:inputType="textPassword"
        android:minHeight="40dp"
        android:singleLine="true"
        android:textColorHint="#3F51B5"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/userPlainText" />

    <Button
        android:id="@+id/loginButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:backgroundTint="#3F51B5"
        android:text="Bejelentkezés"
        android:textSize="20sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/editTextTextPassword" />

    <Button
        android:id="@+id/forgotPasswordButton"
        android:layout_width="196dp"
        android:layout_height="46dp"
        android:layout_marginTop="4dp"
        android:backgroundTint="#803F51B5"
        android:text="Elfelejtett jelszó"
        android:textSize="16sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.512"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/loginButton" />

</androidx.constraintlayout.widget.ConstraintLayout>